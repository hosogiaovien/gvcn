rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role && getUserData().status == 'ACTIVE';
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isSchoolLeadership() {
      return isAuthenticated() && (
        getUserData().role in ['ADMIN', 'HIEU_TRUONG', 'PHO_HIEU_TRUONG', 'TONG_PHU_TRACH', 'GIAM_THI']
      ) && getUserData().status == 'ACTIVE';
    }

    function isGVCN(classId) {
      return isAuthenticated() && getUserData().role == 'GVCN' && getUserData().classId == classId && getUserData().status == 'ACTIVE';
    }

    function isGroupLeader(classId, groupId) {
      return isAuthenticated() && getUserData().role == 'TO_TRUONG' &&
        getUserData().classId == classId && getUserData().groupId == groupId &&
        getUserData().status == 'ACTIVE';
    }

    // Schools & SchoolYears
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /schoolYears/{yearId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /systemSettings/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isSchoolLeadership());
      allow write: if isAdmin();
    }

    // Classes
    match /classes/{classId} {
      allow read: if true; // Public access to class names for parent portal
      allow write: if isAdmin() || isGVCN(classId);
    }

    // Groups
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && getUserData().classId == resource.data.classId);
    }

    // Students
    match /students/{studentId} {
      allow read: if isSchoolLeadership() ||
        (isAuthenticated() && getUserData().role == 'GVCN' && getUserData().classId == resource.data.classId) ||
        (isAuthenticated() && getUserData().role == 'TO_TRUONG' && getUserData().classId == resource.data.classId && getUserData().groupId == resource.data.groupId);
      allow write: if isAdmin() || (isAuthenticated() && getUserData().role == 'GVCN' && getUserData().classId == request.resource.data.classId);
    }

    // Criteria
    match /criteria/{criterionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && getUserData().role == 'GVCN');
    }

    // Competition Transactions
    match /competitionTransactions/{txId} {
      allow read: if isSchoolLeadership() ||
        (isAuthenticated() && getUserData().role == 'GVCN' && getUserData().classId == resource.data.classId) ||
        (isAuthenticated() && getUserData().role == 'TO_TRUONG' && getUserData().classId == resource.data.classId && getUserData().groupId == resource.data.groupId);
      
      allow create: if isAdmin() ||
        (isAuthenticated() && getUserData().role == 'GVCN' && getUserData().classId == request.resource.data.classId) ||
        (isAuthenticated() && getUserData().role == 'TO_TRUONG' && getUserData().classId == request.resource.data.classId && getUserData().groupId == request.resource.data.groupId) ||
        (isAuthenticated() && (getUserData().role == 'GIAM_THI' || getUserData().role == 'TONG_PHU_TRACH'));

      allow update: if isAdmin() ||
        (isAuthenticated() && getUserData().role == 'GVCN' && getUserData().classId == resource.data.classId);

      allow delete: if isAdmin();
    }

    // Weekly Summaries
    match /weeklySummaries/{summaryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && getUserData().role == 'GVCN' && getUserData().classId == request.resource.data.classId);
    }

    // Monthly Summaries
    match /monthlySummaries/{summaryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && getUserData().role == 'GVCN' && getUserData().classId == request.resource.data.classId);
    }

    // Public Shares: public can read active share by token query
    match /publicShares/{shareId} {
      allow read: if true; // Public access for parent portal view
      allow write: if isAdmin() || (isAuthenticated() && getUserData().role == 'GVCN');
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin() || (isAuthenticated() && getUserData().role == 'GVCN' && getUserData().classId == resource.data.classId);
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit logs
    }
  }
}
